<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>org.g14.TypedConfig.Analyzer</AssemblyName>
        <RootNamespace>org.g14.TypedConfig.Analyzer</RootNamespace>

        <!-- prevent shooting ourselves in the foot; see https://stackoverflow.com/a/75767670/1387378 -->
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!-- mark this project as an analyzer -->
        <IsRoslynComponent>true</IsRoslynComponent>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <!-- Not including symbols, we'll use sourcelink instead -->
        <IncludeSymbols>false</IncludeSymbols>
        <!--        <SymbolPackageFormat>snupkg</SymbolPackageFormat>-->
    </PropertyGroup>

</Project>
