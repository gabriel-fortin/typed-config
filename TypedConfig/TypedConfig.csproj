<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>

        <!-- bits for nuget -->
        <Version>0.69.0</Version>
        <PackageId>org.g14.TypedConfig</PackageId>
        <Authors>Gabriel Fortin</Authors>
        <Title>Typed Config</Title>
        <Description>Generates classes to access the content of appsettings in a type-safe way</Description>
        <PackageTags>configuration;appsettings;type-safety;roslyn;source-generator;code-generation;codegen</PackageTags>
        <Copyright>Copyright (c) 2026 Gabriel Fortin</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/gabriel-fortin/typed-config</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>

        <!-- do not include the DLL generated by this project -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- because we use it just to create a nuget package containing analyzers -->
        <PackageType>Analyzer</PackageType>

        <PackageOutputPath>../generated_nuget_packages</PackageOutputPath>

        <!-- This project emits no DLL itself; dotnet pack warns about missing DLLs for the declared target framework -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <!-- define the location of the README in the created nuget package -->
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="/">
            <Link>README.md</Link>
        </None>
    </ItemGroup>

    <!-- include DLLs from sibling projects; include them in the nuget as analyzers/generators -->
    <ItemGroup>
        <ProjectReference Include="../TypedConfig.Analyzer/TypedConfig.Analyzer.csproj" PrivateAssets="All" />
        <ProjectReference Include="../TypedConfig.Generator/TypedConfig.Generator.csproj" PrivateAssets="All" />
        <None Include="$(OutputPath)/*.TypedConfig.Analyzer.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
        <None Include="$(OutputPath)/*.TypedConfig.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>

</Project>
