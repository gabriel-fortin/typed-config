<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AssemblyName>org.g14.FeatureFlags.Analyzer</AssemblyName>
        <RootNamespace>org.g14.FeatureFlags.Analyzer</RootNamespace>
        <Version>0.1.0</Version>
        
        <!-- prevent shooting ourselves in the foot; see https://stackoverflow.com/a/75767670/1387378 -->
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!-- mark this project as an analyzer -->
        <IsRoslynComponent>true</IsRoslynComponent>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    </ItemGroup>

</Project>
