<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>1.0.0</Version>

        <!-- prevent shooting ourselves in the foot; see https://stackoverflow.com/a/75767670/1387378 -->
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!-- mark this project as a source-generator/analyzer -->
        <IsRoslynComponent>true</IsRoslynComponent>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <PackageOutputPath>../local_nuget_packages</PackageOutputPath>

        <!-- bits for nuget -->
        <AssemblyName>org.g14.TypedConfig.Generator</AssemblyName>
        <RootNamespace>org.g14.TypedConfig.Generator</RootNamespace>
        <!--  <PackageId>  defaults to assembly name so we ignore it -->
        <Authors>Gabriel Fortin</Authors>
        <Title>Typed Config (generator)</Title>
        <Description>Generates classes to access the content of appsettings in a type-safe way - just the generator</Description>
        <PackageTags>configuration;appsettings;type-safety;roslyn;source-generator;code-generation;codegen</PackageTags>
        <Copyright>Copyright (c) 2026 Gabriel Fortin</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/gabriel-fortin/typed-config</PackageProjectUrl>
        <RepositoryUrl>https://github.com/gabriel-fortin/typed-config</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <!-- Not including symbols, we'll use sourcelink instead -->
        <IncludeSymbols>false</IncludeSymbols>
        <!--        <SymbolPackageFormat>snupkg</SymbolPackageFormat>-->

        <!-- Development dependency - doesn't add runtime dependencies to consuming projects -->
        <DevelopmentDependency>true</DevelopmentDependency>

        <!-- do not incude a normal DLL (an analyzer-type DLL will be added but in a different way) -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <!-- Make part of the packed nuget: pack the generator DLL into the analyzers folder -->
    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

<!--  I'm not sure if the AnalyzerReleases files need to be specified here  -->
<!--    <ItemGroup>-->
<!--      <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />-->
<!--      <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />-->
<!--    </ItemGroup>-->

</Project>
