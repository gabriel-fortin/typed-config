<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.1.0-alpha007</Version>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <AssemblyName>org.g14.TypedConfig.Generator</AssemblyName>
        <RootNamespace>org.g14.TypedConfig.Generator</RootNamespace>

        <!-- prevent shooting ourselves in the foot; see https://stackoverflow.com/a/75767670/1387378 -->
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!-- mark this project as a source-generator/analyzer -->
        <IsRoslynComponent>true</IsRoslynComponent>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" PrivateAssets="all" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <!-- Not including symbols, we'll use sourcelink instead -->
        <IncludeSymbols>false</IncludeSymbols>
        <!--<SymbolPackageFormat>snupkg</SymbolPackageFormat>-->
    </PropertyGroup>

    <!--  I'm not sure if the AnalyzerReleases files need to be specified here  -->
    <!-- <ItemGroup>-->
    <!--   <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />-->
    <!--   <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />-->
    <!-- </ItemGroup>-->

</Project>
